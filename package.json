{
  "name": "meubotequim-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MeuBotequim - Gestão de Estoque e Reposição para Bares e Restaurantes",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "seed:backend": "npm --prefix backend run seed",
    "migrate:backend": "npm --prefix backend run migrate"
  }
}
